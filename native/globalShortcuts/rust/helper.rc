        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", L"PulseSync\0"
            VALUE "FileDescription", L"Системный помощник PulseSync\0"
            VALUE "FileVersion", HELPER_VERSION_TEXT
            VALUE "InternalName", L"pulsesync_hotkeys\0"
            VALUE "OriginalFilename", L"pulsesync_hotkeys.exe\0"
            VALUE "ProductName", L"PulseSync\0"
            VALUE "ProductVersion", HELPER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
