{
    "bracketSpacing": true,
    "jsxSingleQuote": false,
    "semi": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 170,
    "endOfLine": "lf",
    "arrowParens": "always",
    "singleQuote": true,
    "sortPackageJson": false,
    "ignorePatterns": [
        "node_modules",
        ".webpack",
        ".idea",
        "out",
        "tsconfig.json",
        "README.md",
        "yarn.lock",
        "ReactDevTools",
        "temp_build",
        "*.html",
        "*.txt"
    ]
}
