{
    "bracketSpacing": true,
    "jsxSingleQuote": false,
    "semi": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "printWidth": 170,
    "endOfLine": "lf",
    "arrowParens": "always",
    "singleQuote": true,
    "sortPackageJson": false,
    "overrides": [
        {
            "files": ["webModules/**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss}"],
            "options": {
                "printWidth": 120,
                "objectWrap": "preserve"
            }
        }
    ],
    "ignorePatterns": ["node_modules", ".webpack", ".idea", "out", "tsconfig.json", "README.md", "yarn.lock", "ReactDevTools", "temp_build"]
}
