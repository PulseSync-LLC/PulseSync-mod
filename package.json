{
    "name": "pulsesync-asar",
    "packageManager": "yarn@4.18.1",
    "workspaces": [
        "native/setIconicThumbnail",
        "native/wasapiExclusive"
    ],
    "version": "2.1.6",
    "description": "Mod for Yandex Music Desktop",
    "main": "index.js",
    "scripts": {
        "dev": "node toolset.js dev",
        "update:ncs-catalog": "node toolset/utils/updateNcsCatalog.js",
        "release": "node toolset.js release",
        "buildMod": "node toolset.js build -d",
        "buildModProd": "node toolset.js build -m",
        "rebuildMod": "node toolset.js rebuild",
        "buildModTest": "node toolset.js build -m -d",
        "buildMin": "node toolset.js build -d -m",
        "downloadLatest": "node toolset.js download",
        "migrateReport": "node toolset.js migrate-report",
        "migrateTodo": "node toolset.js migrate-todo",
        "test": "echo \"Error: no test specified\" && exit 1",
        "test:release": "node --test toolset/tests/release.test.js",
        "onUpdate": "node toolset.js extract && node toolset.js pretty && node toolset.js adaptive-patch --version=latest && node toolset.js rebuild --src=\"extracted\\latest@pretty\"",
        "onUpdate:noAP": "node toolset.js extract && node toolset.js pretty && node toolset.js rebuild --src=\"extracted\\latest@pretty\"",
        "toolset:dev": "node toolset.js dev",
        "toolset:update-ncs-catalog": "node toolset/utils/updateNcsCatalog.js",
        "toolset:release": "node toolset.js release",
        "toolset:buildDirect": "node toolset.js build -d",
        "toolset:buildProd": "node toolset.js build -m",
        "toolset:rebuild": "node toolset.js rebuild",
        "toolset:buildMin": "node toolset.js build -d -m",
        "toolset:downloadLatest": "node toolset.js download",
        "toolset:migrateReport": "node toolset.js migrate-report",
        "toolset:migrateTodo": "node toolset.js migrate-todo",
        "toolset:clearCaches": "node toolset.js clearCaches"
    },
    "author": "PulseSync <contact@pulsesync.dev>",
    "license": "GPL-3.0+",
    "dependencies": {
        "7zip-min": "^3.0.1",
        "@babel/generator": "^8.0.6",
        "@babel/parser": "^7.29.9",
        "@babel/traverse": "^8.0.6",
        "@babel/types": "^8.0.6",
        "@electron/asar": "^4.3.1",
        "@octokit/rest": "^22.0.1",
        "@types/node": "^26.6.4",
        "axios": "^1.20.0",
        "chalk": "^6.0.1",
        "css-tree": "^3.2.1",
        "dotenv": "^18.0.5",
        "electron": "38.2.2",
        "fast-glob": "^3.3.3",
        "form-data": "^4.0.6",
        "glob": "^13.0.6",
        "js-yaml": "^5.4.2",
        "listr2": "^11.1.1",
        "minimist": "^1.2.8",
        "multicast-dns": "^7.2.5",
        "node-gyp": "^13.1.0",
        "oxfmt": "0.75.0",
        "plist": "^5.0.0",
        "postcss": "^8.5.32",
        "readline-sync": "^1.4.10",
        "semver": "^7.8.5",
        "sharp": "^0.35.5",
        "terser": "^5.51.2",
        "ws": "^8.22.0",
        "zstd-codec": "^0.1.5"
    },
    "devDependencies": {
        "nocopyrightsounds-api": "3.0.2"
    }
}